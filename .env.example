# Set this in Vercel to the Railway service's public URL.
VITE_API_URL=https://your-railway-service.up.railway.app
# Set this in Railway to your Vercel deployment origin (without a trailing slash).
FRONTEND_ORIGINS=https://your-vercel-app.vercel.app
# Attach a Railway PostgreSQL database and set DATABASE_URL to its connection URL.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
